// Edit these two lines before building on a device.
//
// DEVELOPMENT_TEAM: your Apple Developer team ID (Xcode > Settings > Accounts).
// BUNDLE_ID_PREFIX: a reverse-DNS prefix you own, e.g. com.yourname
//
// The app, widget and App Group identifiers are all derived from the prefix:
//   $(BUNDLE_ID_PREFIX).dailyxkcd
//   $(BUNDLE_ID_PREFIX).dailyxkcd.widget
//   group.$(BUNDLE_ID_PREFIX).dailyxkcd

DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = com.example

APP_GROUP_ID = group.$(BUNDLE_ID_PREFIX).dailyxkcd
